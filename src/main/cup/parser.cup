package lyc.compiler;

import java_cup.runtime.*;

import java.util.ArrayList;
import java.util.Stack;

import lyc.compiler.simboleTable.SymbolTable;
import lyc.compiler.model.*;
import lyc.compiler.constants.Constants;
import lyc.compiler.model.InvalidLengthException;
import lyc.compiler.intermediateCode.Polaca;

class Parser;
action code {:

public ArrayList<String> varType = new ArrayList<>();
SymbolTable symTable = SymbolTable.getSymbolTable();
Polaca polaca = Polaca.getInstance();
boolean generandoCondicion = false;
boolean rellenarVerdaderoPendiente = false;
Stack<Integer> pilaSaltosAnd = new Stack<>();

private void semanticError(String msg){
  throw new RuntimeException("Semantic error: " + msg);
}

private void requireDeclared(String id){
      semanticError("Variable no declarada: " + id);
}

private String validateNegativeInteger(String value) {
        String valNegativo = "-" + value;
        try {
            int intValue = Integer.parseInt(valNegativo);
            if (intValue < Constants.MIN_INT) {
             throw new  RuntimeException(new InvalidLengthException("La variable INT " + valNegativo + " es inferior a lo permitido."));
            }
            return "INT";
        } catch (NumberFormatException e) {
         throw new RuntimeException(new InvalidLengthException("La variable INT " + valNegativo + " es inválida."));
        }
}

private String validateNegativeFloat(String value) {
        String valNegativo = "-" + value;
        try {
            double floatValue = Double.parseDouble(valNegativo);
            if (floatValue < Constants.MIN_FLOAT) {
           throw new    RuntimeException(new InvalidLengthException("La variable FLOAT " + valNegativo + " es inferior a lo permitido."));
            }
            return "FLOAT";
        } catch (NumberFormatException e) {
           throw new RuntimeException(new InvalidLengthException("La variable FLOAT " + valNegativo + " es inválida."));
            }
}

//Metodos adicionales para menejo de listas de saltos verdaderos y falsos
private void rellenarVerdaderoSiPendiente() {
    if (rellenarVerdaderoPendiente) {
        polaca.rellenarSaltosVerdadero(polaca.getPosicionActual());
        rellenarVerdaderoPendiente = false;
    }
}

//Separa en un metod las preparacion de etiquetas de saltos de las expresiones
private void reservarSaltoComparacion(String operadorSalto) {
    polaca.addElement("CMP");
    polaca.addElement(operadorSalto);
    polaca.apilarSaltoFalso(polaca.getPosicionActual());
    polaca.addElement("_");
}


:};

// Terminals
terminal ASSIG;
terminal PLUS;
terminal SUB;
terminal MULT;
terminal DIV;
terminal MORETHAN;
terminal MOREEQUALTHAN;
terminal LESSTHAN;
terminal LESSEQUALTHAN;
terminal EQUAL;
terminal NOTEQUAL;
terminal OPEN_BRACKET;
terminal CLOSE_BRACKET;
terminal OPEN_KEY;
terminal CLOSE_KEY;
terminal INTEGER_CONSTANT;
terminal IDENTIFIER;
terminal PRINT;
terminal READ;
terminal WHILE;
terminal STRING_CONSTANT;
terminal INIT;
terminal IF;
terminal ELSE;
terminal COLON;
terminal COMMA;
terminal STRING;
terminal FLOAT;
terminal FLOAT_CONSTANT;
terminal INT;
terminal OPEN_ARRAY;
terminal CLOSE_ARRAY;
terminal IN;
terminal FOR;
terminal TO;
terminal STEP;
terminal NEXT;
terminal AND;
terminal OR;
terminal NOT;

// Non Terminals
non terminal program;
non terminal init_sentence;
non terminal init_line;
non terminal init_type;
non terminal var_list;

non terminal sentences;
non terminal first_sentence;
non terminal sentence;
non terminal assignment;
non terminal expression;
non terminal term;
non terminal factor;
non terminal print_sentence;
non terminal print_line;
non terminal read_sentence;
non terminal read_line;
non terminal while_sentence;
non terminal condition_line;
non terminal condition_or_especial;
non terminal condition_or;
non terminal condition_and;
non terminal condition_not;
non terminal operation_line;
non terminal if_sentence;
non terminal if_body;
non terminal if_else_bridge;
non terminal for_sentence;
non terminal for_step;
non terminal especial_condition_line;
non terminal expression_array;


// Start Symbol Definition
start with program;

program ::= sentences {: System.out.println("End :Programa"); :};

sentences ::= sentences sentence
            | first_sentence
            ;

first_sentence ::= sentence {: rellenarVerdaderoSiPendiente(); :};

expression ::= expression:e1 PLUS term:t1 
    {: 
        // Validación adicional: ¿Se pueden sumar tipos distintos?
        if(!e1.toString().equals(t1.toString())) {
            semanticError("Operación aritmética entre tipos distintos: " + e1 + " y " + t1);
        }
        polaca.addElement("+");
        RESULT = e1; // Propagamos el tipo
    :};
expression ::= expression:e1 SUB term:t1 
    {: 
        // Validación adicional: ¿Se pueden sumar tipos distintos?
        if(!e1.toString().equals(t1.toString())) {
            semanticError("Operación aritmética entre tipos distintos: " + e1 + " y " + t1);
        }
        polaca.addElement("-");
        RESULT = e1; // Propagamos el tipo
    :};

expression ::= expression:e1 MORETHAN term:t1 {: 
    System.out.println(">");
    if(!e1.toString().equals(t1.toString())) {
        semanticError("Incompatibilidad de tipos en comparación: " + e1 + " vs " + t1);
    }
    if (generandoCondicion) { 
        reservarSaltoComparacion("BLE"); 
    } else { 
        polaca.addElement("CMP"); 
        polaca.addElement("BLE"); 
    } 
    RESULT = "BOOL_CMP"; 
:};

expression ::= expression:e1 MOREEQUALTHAN term:t1 {: 
    System.out.println(">=");
    if(!e1.toString().equals(t1.toString())) {
        semanticError("Incompatibilidad de tipos en comparación: " + e1 + " vs " + t1);
    }
    if (generandoCondicion) { 
        reservarSaltoComparacion("BLT"); 
    } else { 
        polaca.addElement("CMP"); 
        polaca.addElement("BLT"); 
    } 
    RESULT = "BOOL_CMP"; 
:};

expression ::= expression:e1 LESSTHAN term:t1 {: 
    System.out.println("<");
    if(!e1.toString().equals(t1.toString())) {
        semanticError("Incompatibilidad de tipos en comparación: " + e1 + " vs " + t1);
    }
    if (generandoCondicion) { 
        reservarSaltoComparacion("BGE"); 
    } else { 
        polaca.addElement("CMP"); 
        polaca.addElement("BGE"); 
    } 
    RESULT = "BOOL_CMP"; 
:};

expression ::= expression:e1 LESSEQUALTHAN term:t1 {: 
    System.out.println("<=");
    if(!e1.toString().equals(t1.toString())) {
        semanticError("Incompatibilidad de tipos en comparación: " + e1 + " vs " + t1);
    }
    if (generandoCondicion) { 
        reservarSaltoComparacion("BGT"); 
    } else { 
        polaca.addElement("CMP"); 
        polaca.addElement("BGT"); 
    } 
    RESULT = "BOOL_CMP"; 
:};

expression ::= expression:e1 EQUAL term:t1 {: 
    System.out.println("==");
    if(!e1.toString().equals(t1.toString())) {
        semanticError("Incompatibilidad de tipos en comparación: " + e1 + " vs " + t1);
    }
    if (generandoCondicion) { 
        reservarSaltoComparacion("BNE"); 
    } else { 
        polaca.addElement("CMP"); 
        polaca.addElement("BNE"); 
    } 
    RESULT = "BOOL_CMP"; 
:};

expression ::= expression:e1 NOTEQUAL term:t1 {: 
    System.out.println("!=");
    if(!e1.toString().equals(t1.toString())) {
        semanticError("Incompatibilidad de tipos en comparación: " + e1 + " vs " + t1);
    }
    if (generandoCondicion) { 
        reservarSaltoComparacion("BEQ"); 
    } else { 
        polaca.addElement("CMP"); 
        polaca.addElement("BEQ"); 
    } 
    RESULT = "BOOL_CMP"; 
:};

expression ::= term :t {: System.out.println("Expression = Term");
                          RESULT = t;:};
term ::= term:t1 MULT factor:f1 
    {: 
        // 1. Validar que t1 y f1 sean del mismo tipo (ej: no multiplicar INT por STRING)
        if(!t1.toString().equals(f1.toString())) {
            semanticError("Tipos incompatibles en multiplicación: " + t1 + " * " + f1);
        }
        System.out.println("*");
        polaca.addElement("*"); 
        // 2. Propagar el tipo resultante al nivel superior
        RESULT = t1; 
    :};
term ::= term:t1 DIV factor:f1 
    {: 
        if(!t1.toString().equals(f1.toString())) {
            semanticError("Tipos incompatibles en división: " + t1 + " / " + f1);
        }
        System.out.println("/");
        polaca.addElement("/"); 
        RESULT = t1; 
    :};
term ::= factor:f {:
                System.out.println("Term = factor");
                RESULT = f;
                :};
factor ::= IDENTIFIER:id 
    {: 
        String name = id.toString();
        // 1. Verificar que la variable exista
        if(!symTable.exists(name)){ 
            requireDeclared(name); 
        }
        // 2. Agregar a la polaca
        polaca.addElement(name);
        
        // 3. RETORNAR el tipo para que suba por term y expression
        RESULT = symTable.getType(name); 
        System.out.println("Id: " + name + " (Tipo: " + RESULT + ")");
    :};

factor ::= INTEGER_CONSTANT:constant {:
                            System.out.println("Constant: " + constant );
                            symTable.insert(constant.toString(),"INT",constant.toString(),false);
                            RESULT = "INT";
                            polaca.addElement(constant.toString());
                            :};

factor ::= FLOAT_CONSTANT:constant {:
                            System.out.println("Constant: " + constant );
                            symTable.insert(constant.toString(),"FLOAT",constant.toString(),false);
                            RESULT = "FLOAT";
                            polaca.addElement(constant.toString());
                            :};

// FACTORES NEGATIVO
// --- Integer Negativo ---
factor ::= SUB INTEGER_CONSTANT:constant {:
    String valNegativo = "-" + constant.toString();
        String type = validateNegativeInteger(constant.toString());
        System.out.println("Constant Negativa: " + valNegativo);
        symTable.insert(valNegativo, type, valNegativo, false);
        polaca.addElement(valNegativo.toString());
        RESULT = type;
:};

// --- Float Negativo ---
factor ::= SUB FLOAT_CONSTANT:constant {:
    String valNegativo = "-" + constant.toString();
        String type = validateNegativeFloat(constant.toString());
        System.out.println("Constant Negativa: " + valNegativo);
        symTable.insert(valNegativo, type, valNegativo, false);
         polaca.addElement(valNegativo.toString());
        RESULT = type;
:};


factor ::= STRING_CONSTANT:constant {:
                        System.out.println("Constant: " + constant );
                        symTable.insert(constant.toString(),"STRING",constant.toString(),false);
                        RESULT = "STRING";
                        polaca.addElement(constant.toString());
                                                        :};
factor ::= OPEN_BRACKET expression:e CLOSE_BRACKET 
{: 
    System.out.println("Factor = (Expression)"); 
    // Importante: El factor ahora toma el tipo de la expresión interna
    RESULT = e; 
:};

// condicionales (recursión a la derecha para evitar conflictos shift/reduce)
condition_line ::= condition_or {: rellenarVerdaderoPendiente = true; :};

condition_or ::= condition_and OR 
    {: 
        // Si el lado izquierdo es VERDADERO, ya no evaluamos el resto (cortocircuito).
        // Sacamos el "Salto si Falso" que dejó el condition_and y lo invertimos.
        int saltoFalsoIzquierdo = polaca.desapilarSaltoFalso();
        polaca.invertirSaltoCondicional(saltoFalsoIzquierdo);
        
        // Ahora es un "Salto si Verdadero", lo mandamos a la lista de saltos 
        // que se rellenarán al inicio del bloque sentences.
        polaca.apilarSaltoVerdadero(saltoFalsoIzquierdo); 
    :} 
    condition_or 
    {: 
        System.out.println("OR"); 
    :};

condition_or ::= condition_and;

condition_and ::= condition_not AND 
    {: 
        pilaSaltosAnd.push(polaca.desapilarSaltoFalso()); 
    :} 
    condition_and 
    {: 
        // Recuperamos el salto específico de este nivel de anidación
        int saltoIzquierdoLocal = pilaSaltosAnd.pop();
        int saltoDer = polaca.desapilarSaltoFalso();

        // La izquierda debe saltar al mismo destino final que la derecha:
        // se vincula para que rellenarSaltosFalso resuelva ambas juntas.
        polaca.vincularSaltoFalso(saltoDer, saltoIzquierdoLocal);
        polaca.apilarSaltoFalso(saltoDer);
        System.out.println("AND");
    :};
condition_and ::= condition_not;

condition_not ::= NOT condition_not {:
    // Rellenar el salto falso de la izquierda CON la posición actual
    int salto = polaca.desapilarSaltoFalso();
    polaca.invertirSaltoCondicional(salto);
    polaca.apilarSaltoFalso(salto);
    System.out.println("NOT");
:};
condition_not ::= expression:expr 
    {: 
        // Si la expresión no es una comparación (ej: IF(a)), 
        // forzamos una comparación para que exista un salto en la pila.
        if (expr == null || !expr.toString().equals("BOOL_CMP")) {
            polaca.addElement("1"); // Comparamos contra 1 (True)
            reservarSaltoComparacion("BNE"); 
            RESULT = "BOOL_CMP";
        }
    :};

// operaciones (While, For, If)
operation_line ::= OPEN_KEY {:rellenarVerdaderoSiPendiente(); :}
                   sentences CLOSE_KEY {: System.out.println("Bloque de codigo {}"); :};

// Assignments
sentence ::= assignment {: System.out.println("End Asignacion"); :};

assignment ::= IDENTIFIER:id ASSIG expression:expType  
{:
        String idName = id.toString();
        // 1. Validar que la variable de la izquierda esté declarada o dar de alta por uso
        // 2. Obtener el tipo de la variable de la izquierda
        String idType = symTable.getType(idName);
        idType = idType.equals("Undefined") ? expType.toString() : idType;
        if(!symTable.exists(idName)){
            symTable.insert(idName, expType.toString(), "", true); 
            System.out.println("Alta por uso: " + idName + " como " + expType);
        }
        // 3. CHEQUEO SEMÁNTICO: Comparar tipos
        // expType vendrá como "INT", "FLOAT" o "STRING" desde la regla expression
        if (!idType.equals(expType)) {
            semanticError("Tipos incompatibles: No se puede asignar " + expType + 
                          " a la variable '" + idName + "' que es de tipo " + idType);
        }        
        // 4. Generación de código intermedio
        polaca.addElement(idName);
        polaca.addElement(":=");
        System.out.println("Asignación válida: " + idName + " := " + expType);
        RESULT = idName;
    :};

// WRITE
sentence ::= print_sentence {: System.out.println("End PRINT"); :};
print_sentence ::= PRINT OPEN_BRACKET print_line CLOSE_BRACKET {: System.out.println("Bloque WRITE/PRINT"); :};
print_line ::= IDENTIFIER:id {: 
    System.out.println("Print id: " + id);
    String name = id.toString();
    if(!symTable.exists(name)){
        requireDeclared(name);
    }
    polaca.addElement(name);
    polaca.addElement("PRINT");
    :};
print_line ::= STRING_CONSTANT:constant {:
    System.out.println("Print STRING_CONSTANT: " + constant);
    String c = constant.toString();
    symTable.insert(c,"STRING",c,false);
    polaca.addElement(c);
    polaca.addElement("PRINT");    
    :};

// READ
sentence ::= read_sentence {: System.out.println("End READ"); :};
read_sentence ::= READ OPEN_BRACKET read_line CLOSE_BRACKET {: System.out.println("Bloque READ"); :};
read_line ::= IDENTIFIER:id {: 
    System.out.println("Read: " + id);
    String name = id.toString();
    if(!symTable.exists(name)){
        requireDeclared(name);
    }
    polaca.addElement(name);
    polaca.addElement("READ");
    :};

// Init
sentence ::= init_sentence {: System.out.println("End INIT"); :};
init_sentence ::= INIT OPEN_KEY init_line CLOSE_KEY {: System.out.println("Estructura Bloque INIT"); :};
init_line ::= var_list COLON init_type init_line {::};
init_line ::= var_list COLON init_type {::};

var_list ::= IDENTIFIER: id  COMMA var_list {:
  varType.add(id.toString());
    System.out.println("Variable: "+id);
:};

var_list ::=IDENTIFIER: id  {:
            varType.add(id.toString());
            System.out.println("Variable: "+id.toString());
        :};

init_type ::= STRING {: System.out.println("STRING");
    for (String v: varType){
        if(symTable.exists(v)){
           throw new VariableDeclaredException("La variable \""+v+"\" ya fue declarada.");
        }
        symTable.insert(v,"STRING","",true);
    }
    System.out.println("Declaracion de variables tipo STRING (" + varType.size() + " variables)");
    varType.clear();
:};

init_type ::= FLOAT {: System.out.println("FLOAT");
    for (String v: varType){
        if(symTable.exists(v)){
           throw new VariableDeclaredException("La variable \""+v+"\" ya fue declarada.");
        }
        symTable.insert(v,"FLOAT","",true);
    }
    System.out.println("Declaracion de variables tipo FLOAT (" + varType.size() + " variables)");
    varType.clear();
:};

init_type ::= INT {: System.out.println("INT");
    for (String v: varType){
        if(symTable.exists(v)){
           throw new VariableDeclaredException("La variable \""+v+"\" ya fue declarada.");
        }
        symTable.insert(v,"INT","",true);
    }
    System.out.println("Declaracion de variables tipo INT (" + varType.size() + " variables)");
    varType.clear();
:};

//WHILE
sentence::=while_sentence  {: System.out.println("End WHILE"); :};


while_sentence ::= WHILE {:
        polaca.addElement("ET");
        generandoCondicion = true;

        int posSaltoIncondicional = polaca.getPosicionActual();
        polaca.apilarSaltoPila(posSaltoIncondicional -1);
        generandoCondicion = true;
        System.out.println("Bloque WHILE");
        :}
    
    OPEN_BRACKET condition_or_especial CLOSE_BRACKET {:
        generandoCondicion = false; :}
        operation_line {:
        polaca.addElement("BI");
        int salidaWhile = polaca.getPosicionActual();

        polaca.rellenarSaltosFalso(salidaWhile);

        int inicioDeCondicion = polaca.desapilarSaltoPila();
        polaca.addElement(String.valueOf(inicioDeCondicion));
    :};

// Resuelve la ambigüedad entre condition_line y especial_condition_line
condition_or_especial ::= especial_condition_line
                        | condition_line
                        ;
especial_condition_line ::= IDENTIFIER:id IN OPEN_ARRAY expression_array CLOSE_ARRAY {: System.out.println("condicion especial");
                                                                                        String c = id.toString();
                                                                                        symTable.insert(c,"","",true); :};
expression_array ::= expression COMMA expression_array;
expression_array ::= expression; 

//IF
if_else_bridge ::= ELSE 
    {:
        // 1. Generamos el salto para salir del IF (saltar sobre el ELSE)
        polaca.addElement("BI");
        polaca.apilarSaltoPila(polaca.getPosicionActual()); 
        polaca.addElement("_");
        
        // 2. AHORA completamos el salto falso de la condición 
        // para que apunte a este punto (el inicio del bloque ELSE)
        polaca.rellenarSaltosFalso(polaca.getPosicionActual()); 
    :};
sentence ::= if_sentence {: System.out.println("End IF"); :};

if_sentence ::= IF {: generandoCondicion = true; :} OPEN_BRACKET condition_line CLOSE_BRACKET {: generandoCondicion = false; :} if_body;


if_body ::= operation_line 
    {: 
        System.out.println("Bloque IF Simple"); 
        polaca.rellenarSaltosFalso(polaca.getPosicionActual()); 
    :}
    | operation_line if_else_bridge operation_line 
    {: 
        System.out.println("Bloque IF/ELSE"); 
        // Completamos el BI que dejamos pendiente en el bridge
        int saltoFinIF = polaca.desapilarSaltoPila(); 
        polaca.setElementAt(saltoFinIF, String.valueOf(polaca.getPosicionActual())); 
    :}
    | operation_line if_else_bridge if_sentence 
    {: 
        System.out.println("Bloque ELSE IF"); 
        // Completamos el BI para que el IF padre salte al final de toda la cadena
        int saltoFinIF = polaca.desapilarSaltoPila(); 
        polaca.setElementAt(saltoFinIF, String.valueOf(polaca.getPosicionActual()));
    :};

// FOR - TEMA ESPECIAL
sentence ::= for_sentence {: System.out.println("End FOR"); :};

for_sentence ::= FOR assignment:counterName TO expression:exp2 
    {:
        // 1. alta por uso y validacion tipo variable resuelto por 'assignment'

        // 2. Etiqueta de inicio del bucle
        polaca.addElement("ET");
        int inicioLoop = polaca.getPosicionActual();
        polaca.apilarSaltoPila(inicioLoop - 1);

        // 3. Preparar condición de salida (id > exp2)
        // El valor de exp2 ya está en la polaca por la regla 'expression'
        String name = counterName.toString();
        polaca.addElement(name);
        reservarSaltoComparacion("BLT"); // Polaca: ... ET exp2 id CMP BGT

        RESULT = name; // Pasamos el nombre para validar en el NEXT
    :}
    for_step sentences NEXT IDENTIFIER:idNext
    {:
        String nameFor = (String)RESULT;
        String nameNext = idNext.toString();

        // 4. Validación variable en NEXT debe ser la misma que la variable en FOR
        if(!nameFor.equals(nameNext)) {
            semanticError("Variable en NEXT (" + nameNext + ") no coincide con FOR (" + nameFor + ")");
        }

        // 5. Incremento: id = id + step (el step ya está en la pila, pusheado por for_step)
        polaca.addElement(nameFor); // Operando para sumar con el step pendiente
        polaca.addElement("+");
        polaca.addElement(nameFor); // Destino real de la asignación
        polaca.addElement(":=");

        // 6. Salto al inicio y cierre
        polaca.addElement("BI");
        int posET = polaca.desapilarSaltoPila();
        polaca.addElement(String.valueOf(posET));

        polaca.rellenarSaltosFalso(polaca.getPosicionActual());
    :};

for_step ::= STEP expression {: /* El valor ya está en polaca por 'expression' */ :}
           | {: polaca.addElement("1"); // Paso por defecto si no hay STEP :};